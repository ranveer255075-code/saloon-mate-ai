# Existing AI settings
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.6-flash
ERP_API_URL=http://localhost/renu-api/index.php

# n8n receipt delivery (keep these server-side; never expose them in Vite)
N8N_INVOICE_WEBHOOK_URL=http://localhost:5678/webhook/salonmate/invoice-receipt
N8N_WEBHOOK_SECRET=replace_with_a_long_random_secret
N8N_STATUS_API_KEY=replace_with_a_second_long_random_secret
N8N_REQUEST_TIMEOUT_SECONDS=8
N8N_MAX_RETRIES=2
# Used by the n8n workflow to call this FastAPI service.
ERP_AUTOMATION_API_URL=http://127.0.0.1:8000
# n8n process environment (set these in n8n, not in the browser)
RECEIPT_FROM_EMAIL=verified-sender@example.com
